# PocketBase URL (sin slash al final)
# Interna — usada por Astro SSR para llamar a PocketBase
POCKETBASE_URL=http://localhost:8090

# Pública — usada para construir URLs de archivos que el browser pueda alcanzar
# En dev: misma URL. En prod: dominio público de PocketBase
POCKETBASE_PUBLIC_URL=http://localhost:8090

# Tema del visor de diagramas (/apuntes). Debe coincidir con un archivo en
# src/styles/canvas-themes/<nombre>.css. Por defecto: things
PUBLIC_CANVAS_THEME=dracula

# Umami analytics. Ambas deben estar definidas para que se cargue el script.
# URL de la instancia (sin slash al final) e ID del sitio.
PUBLIC_UMAMI_URL=https://umami.evesan.rocks
PUBLIC_UMAMI_WEBSITE_ID=
