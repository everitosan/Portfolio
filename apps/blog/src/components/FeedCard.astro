---
import Card from 'ui/lib/Card.svelte'
import TagBadge from './TagBadge.astro'
import type { FeedItem } from '@/lib/feed'

interface Props {
  item: FeedItem
  lang: string
}
const { item, lang } = Astro.props

const date = new Date(item.published_at).toLocaleDateString(
  lang === 'es' ? 'es-MX' : 'en-US',
  { year: 'numeric', month: 'long', day: 'numeric' }
)
---

<div class="card-wrapper">
  <Card variant={item.kind === 'note' ? 'quaternary' : 'quinary'}>
    <article class="post">
      {item.cover_url && (
        <img class="post__cover" src={item.cover_url} alt={item.title} loading="lazy" />
      )}
      <div class="post__meta">
        <time datetime={item.published_at}>{date}</time>
        {item.kind === 'note' && (
          <span class="post__badge">{lang === 'es' ? 'diagrama' : 'diagram'}</span>
        )}
      </div>
      <h2 class="post__title">
        <a class="post__link" href={item.url}>{item.title}</a>
      </h2>
      <p class="post__excerpt">{item.excerpt}</p>
      {item.tags.length > 0 && (
        <div class="post__tags">
          {item.tags.map((tag) => <TagBadge name={tag.name} slug={tag.slug} lang={lang} />)}
        </div>
      )}
    </article>
  </Card>
</div>

<style lang="scss">
  @use 'ui/Styles/colors';
  @use 'ui/Styles/typography';
  @use 'ui/Styles/utils';

  .card-wrapper {
    position: relative;
    transition: opacity 0.2s;
    &:hover { opacity: 0.85; }
  }

  .post { padding: utils.sizing(1); }

  .post__cover {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: utils.sizing(2);
    display: block;
  }

  .post__meta {
    @include typography.techie-small-text;
    color: var(--color-muted);
    margin-bottom: utils.sizing(1);
    display: flex;
    align-items: center;
    gap: utils.sizing(1);
  }

  .post__badge {
    border: 1px solid #00ff75;
    color: #00ff75;
    border-radius: 3px;
    padding: 0 6px;
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .post__title {
    @include typography.title-text;
    color: colors.$yellow;
    margin-bottom: utils.sizing(1);
    line-height: 1.3;
  }

  .post__link {
    color: inherit;
    text-decoration: none;
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
    }
  }

  .post__excerpt {
    @include typography.small-text;
    color: colors.$white;
    opacity: 0.75;
    margin-bottom: utils.sizing(2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: utils.sizing(0.5);
    position: relative;
    z-index: 1;
  }
</style>
