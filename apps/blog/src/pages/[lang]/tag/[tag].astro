---
import BlogLayout from '@/layouts/BlogLayout.astro'
import FeedCard from '@/components/FeedCard.astro'
import { getRepository } from '@/lib/repository'
import { getFeedByTag, type FeedItem } from '@/lib/feed'
import type { Lang } from '@/lib/types'

const { lang, tag: tagSlug } = Astro.params
if (lang !== 'en' && lang !== 'es') return Astro.redirect('/en', 301)

const validLang = lang as Lang

let tag
let items: FeedItem[]
try {
  tag = await getRepository().getTag(tagSlug!)
  items = await getFeedByTag(tagSlug!, validLang)
} catch {
  return new Response(null, { status: 404 })
}

const title = `#${tag.name} — ${validLang === 'es' ? 'EveSan · Blog' : "Everardo's Blog"}`
---

<BlogLayout title={title} lang={validLang}>
  <section>
    <div class="tag-header">
      <a class="back" href={`/${validLang}`}>←</a>
      <h1 class="tag-title">#{tag.name}</h1>
    </div>
    <p class="tag-count">
      {items.length} {validLang === 'es' ? 'entradas' : 'entries'}
    </p>

    <div class="grid">
      {items.map((item) => <FeedCard item={item} lang={validLang} />)}
    </div>
  </section>
</BlogLayout>

<style>
  .tag-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .back {
    color: var(--color-muted);
    font-size: 1.2rem;
    text-decoration: none;
  }
  .back:hover { color: var(--color-accent); }

  .tag-title {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    color: var(--color-accent);
  }

  .tag-count {
    color: var(--color-muted);
    font-size: 0.875rem;
    margin-bottom: 2rem;
  }

  .grid { display: grid; gap: 1.25rem; }
</style>
